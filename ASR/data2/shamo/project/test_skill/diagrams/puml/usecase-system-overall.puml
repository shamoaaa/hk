@startuml
skinparam defaultFontName "Microsoft YaHei"
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "平台管理员" as Admin
actor "项目Owner" as Owner
actor "项目Member" as Member
actor "Agent\n决策引擎" as Agent

rectangle "ASR模型自动化优化平台" {
  ' 平台管理员用例
  usecase "用户注册/管理" as UC1
  usecase "创建/删除项目" as UC2
  usecase "分配项目成员" as UC3

  ' 项目Owner用例
  usecase "与Agent交互" as UC4
  usecase "管理公共数据集" as UC5
  usecase "管理热词文件" as UC6
  usecase "修改配置文件" as UC7

  ' 项目Member用例
  usecase "上传个人数据集" as UC9
  usecase "查看实验/Trace/评测" as UC10

  ' Agent引擎用例
  usecase "调用领域技能" as UC11
  usecase "记录Trace链路" as UC12
  usecase "读写记忆系统" as UC13
  usecase "持久化评测结果" as UC14
  usecase "检查GPU资源" as UC15
}

Admin --> UC1
Admin --> UC2
Admin --> UC3

Owner --> UC4
Owner --> UC5
Owner --> UC6
Owner --> UC7

Member --> UC4
Member --> UC9
Member --> UC10

UC11 <-- Agent
UC12 <-- Agent
UC13 <-- Agent
UC14 <-- Agent
UC15 <-- Agent
@enduml
