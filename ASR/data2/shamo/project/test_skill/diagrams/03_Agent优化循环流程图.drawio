<mxfile host="app.diagrams.net">
  <diagram name="Agent优化循环" id="loop">
    <mxGraphModel dx="800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="960" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="开始" style="ellipse;whiteSpace=wrap;fillColor=#F0F0F0;strokeColor=#333333;fontSize=10;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="290" y="20" width="70" height="30" as="geometry" />
        </mxCell>
        <mxCell id="3" value="获取紧凑记忆 + 实验树状态 + 最新评估结果" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="230" y="70" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4" value="THINK：分析瓶颈，确定优化方向" style="rounded=0;whiteSpace=wrap;fillColor=#F0F0F0;strokeColor=#333333;fontSize=10;fontStyle=1;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="220" y="130" width="210" height="35" as="geometry" />
        </mxCell>
        <mxCell id="5" value="搜索策略选择" style="rhombus;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="255" y="185" width="140" height="55" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Draft&#10;新方向" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="110" y="195" width="70" height="35" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Improve&#10;当前最优" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=8;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="470" y="195" width="70" height="35" as="geometry" />
        </mxCell>
        <mxCell id="8" value="EXECUTE：调用Skill执行&#10;（增强 / 训练 / 评估等）" style="rounded=0;whiteSpace=wrap;fillColor=#F0F0F0;strokeColor=#333333;fontSize=10;fontStyle=1;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="215" y="265" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="9" value="等待执行结果" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="250" y="325" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="10b" value="REFLECT：分析结果，对比基线，&#10;记录经验到记忆系统" style="rounded=0;whiteSpace=wrap;fillColor=#F0F0F0;strokeColor=#333333;fontSize=10;fontStyle=1;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="210" y="375" width="230" height="40" as="geometry" />
        </mxCell>
        <mxCell id="11b" value="继续优化？" style="rhombus;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="265" y="435" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="12b" value="是" style="text;fontSize=8;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="155" y="448" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="13b" value="否" style="text;fontSize=8;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="395" y="448" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="14b" value="生成优化总结报告&#10;存入数据库" style="rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="420" y="500" width="130" height="35" as="geometry" />
        </mxCell>
        <mxCell id="15b" value="结束" style="ellipse;whiteSpace=wrap;fillColor=#F0F0F0;strokeColor=#333333;fontSize=10;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="450" y="555" width="70" height="30" as="geometry" />
        </mxCell>
        <!-- 连线 -->
        <mxCell id="ea" style="strokeColor=#333333" edge="1" source="2" target="3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb" style="strokeColor=#333333" edge="1" source="3" target="4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec" style="strokeColor=#333333" edge="1" source="4" target="5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed" style="strokeColor=#333333" edge="1" source="5" target="6" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ee" style="strokeColor=#333333" edge="1" source="5" target="7" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef" style="strokeColor=#333333" edge="1" source="5" target="8" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eg" style="strokeColor=#333333" edge="1" source="8" target="9" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eh" style="strokeColor=#333333" edge="1" source="9" target="10b" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ei" style="strokeColor=#333333" edge="1" source="10b" target="11b" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ej" style="strokeColor=#333333;exitX=0;exitY=0.5;entryX=0;entryY=0.5;curved=1" edge="1" source="11b" target="4" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="460" /><mxPoint x="140" y="147" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="ek" style="strokeColor=#333333" edge="1" source="11b" target="14b" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el" style="strokeColor=#333333" edge="1" source="14b" target="15b" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
